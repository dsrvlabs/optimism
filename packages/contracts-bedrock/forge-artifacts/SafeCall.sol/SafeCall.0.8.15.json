ype":"YulFunctionCall","src":"4665:24:236"},{"kind":"number","nodeType":"YulLiteral","src":"4691:2:236","type":"","value":"63"}],"functionName":{"name":"mul","nodeType":"YulIdentifier","src":"4661:3:236"},"nodeType":"YulFunctionCall","src":"4661:33:236"}],"functionName":{"name":"add","nodeType":"YulIdentifier","src":"4639:3:236"},"nodeType":"YulFunctionCall","src":"4639:56:236"}],"functionName":{"name":"lt","nodeType":"YulIdentifier","src":"4620:2:236"},"nodeType":"YulFunctionCall","src":"4620:76:236"}],"functionName":{"name":"iszero","nodeType":"YulIdentifier","src":"4613:6:236"},"nodeType":"YulFunctionCall","src":"4613:84:236"},"variableNames":[{"name":"_hasMinGas","nodeType":"YulIdentifier","src":"4599:10:236"}]}]},"evmVersion":"london","externalReferences":[{"declaration":119732,"isOffset":false,"isSlot":false,"src":"4599:10:236","valueSize":1},{"declaration":119724,"isOffset":false,"isSlot":false,"src":"4647:7:236","valueSize":1},{"declaration":119726,"isOffset":false,"isSlot":false,"src":"4676:12:236","valueSize":1}],"id":119734,"nodeType":"InlineAssembly","src":"4497:210:236"},{"expression":{"id":119735,"name":"_hasMinGas","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":119732,"src":"4723:10:236","typeDescriptions":{"typeIdentifier":"t_bool","typeString":"bool"}},"functionReturnParameters":119730,"id":119736,"nodeType":"Return","src":"4716:17:236"}]},"documentation":{"id":119722,"nodeType":"StructuredDocumentation","src":"2504:1866:236","text":"@notice Helper function to determine if there is sufficient gas remaining within the context\n         to guarantee that the minimum gas requirement for a call will be met as well as\n         optionally reserving a specified amount of gas for after the call has concluded.\n @param _minGas      The minimum amount of gas that may be passed to the target context.\n @param _reservedGas Optional amount of gas to reserve for the caller after the execution\n                     of the target context.\n @return `true` if there is enough gas remaining to safely supply `_minGas` to the target\n         context as well as reserve `_reservedGas` for the caller after the execution of\n         the target context.\n @dev !!!!! FOOTGUN ALERT !!!!!\n      1.) The 40_000 base buffer is to account for the worst case of the dynamic cost of the\n          `CALL` opcode's `address_access_cost`, `positive_value_cost`, and\n          `value_to_empty_account_cost` factors with an added buffer of 5,700 gas. It is\n          still possible to self-rekt by initiating a withdrawal with a minimum gas limit\n          that does not account for the `memory_expansion_cost` & `code_execution_cost`\n          factors of the dynamic cost of the `CALL` opcode.\n      2.) This function should *directly* precede the external call if possible. There is an\n          added buffer to account for gas consumed between this check and the call, but it\n          is only 5,700 gas.\n      3.) Because EIP-150 ensures that a maximum of 63/64ths of the remaining gas in the call\n          frame may be passed to a subcontext, we need to ensure that the gas will not be\n          truncated.\n      4.) Use wisely. This function is not a silver bullet."},"implemented":true,"kind":"function","modifiers":[],"name":"hasMinGas","nameLocation":"4384:9:236","parameters":{"id":119727,"nodeType":"ParameterList","parameters":[{"constant":false,"id":119724,"mutability":"mutable","name":"_minGas","nameLocation":"4402:7:236","nodeType":"VariableDeclaration","scope":119738,"src":"4394:15:236","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"},"typeName":{"id":119723,"name":"uint256","nodeType":"ElementaryTypeName","src":"4394:7:236","typeDescriptions":{"typeIdentifier":"t_uint256","typeString":"uint256"}},"visibility":"internal"},{"constant":false,"id":119726,"mutability":"mutable","name":"_reservedGas","nameLocation":"4419:12:236","nodeType":"V